---
import Layout from "../layouts/Layout.astro";
import { t, links, projects, skillGroups, certifications, type Lang } from "../data/content";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const otherLangHref = lang === "en" ? `${base}/ar/` : `${base}/`;
const year = new Date().getFullYear();

const navItems = [
  ["about", c.nav.about],
  ["work", c.nav.work],
  ["skills", c.nav.skills],
  ["certifications", c.nav.certs],
  ["contact", c.nav.contact],
] as const;

const arrow = lang === "ar" ? "←" : "→";
---

<Layout lang={lang}>
  <!-- Header -->
  <header class="fixed inset-x-0 top-0 z-50 border-b border-line/60 bg-bg/70 backdrop-blur-xl">
    <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
      <a href={`${base}${lang === "ar" ? "/ar/" : "/"}`} class="flex items-center gap-2 font-semibold tracking-tight">
        <span class="grid size-8 place-items-center rounded-lg bg-accent text-sm font-bold text-white">S</span>
        <span class="hidden sm:inline">{c.name}</span>
      </a>
      <ul class="hidden items-center gap-1 text-sm text-muted md:flex">
        {navItems.map(([id, label]) => (
          <li><a href={`#${id}`} class="rounded-md px-3 py-2 transition hover:bg-accent-soft hover:text-ink">{label}</a></li>
        ))}
      </ul>
      <div class="flex items-center gap-2">
        <a href={otherLangHref} class="rounded-md border border-line px-3 py-1.5 text-sm transition hover:border-accent hover:text-accent" lang={lang === "en" ? "ar" : "en"}>{c.switchLang}</a>
        <button data-theme-toggle aria-label={c.theme} class="grid size-9 place-items-center rounded-md border border-line transition hover:border-accent hover:text-accent">
          <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
      </div>
    </nav>
  </header>

  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden pt-28 pb-20 sm:pt-36 sm:pb-28">
      <div class="glow pointer-events-none absolute inset-0"></div>
      <div class="grid-bg pointer-events-none absolute inset-0"></div>
      <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-[1.3fr_1fr]">
        <div class="reveal">
          <span class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/80 px-3 py-1 text-xs text-muted">
            <span class="relative flex size-2"><span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span></span>
            {c.status}
          </span>
          <h1 class="mt-6 text-4xl font-bold tracking-tight sm:text-6xl">
            <span class="block text-muted text-2xl font-medium sm:text-3xl">{c.hello}</span>
            <span class="bg-gradient-to-br from-ink to-accent bg-clip-text text-transparent">{c.name}</span>
          </h1>
          <p class="mt-4 text-lg font-medium text-accent">{c.role}</p>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">{c.intro}</p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a href="#contact" class="rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-accent/25 transition hover:-translate-y-0.5 hover:shadow-accent/40">{c.contactCta}</a>
            <a href={links.resume} target="_blank" rel="noopener" class="rounded-lg border border-line bg-surface px-5 py-3 text-sm font-semibold transition hover:-translate-y-0.5 hover:border-accent">{c.resume}</a>
            <div class="flex items-center gap-1 ps-2">
              <a href={links.github} target="_blank" rel="noopener" aria-label="GitHub" class="grid size-10 place-items-center rounded-lg text-muted transition hover:bg-accent-soft hover:text-ink">
                <svg class="size-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.1 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5z"/></svg>
              </a>
              <a href={links.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="grid size-10 place-items-center rounded-lg text-muted transition hover:bg-accent-soft hover:text-ink">
                <svg class="size-5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.4 20.5h-3.6v-5.6c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9v5.7H9.3V9h3.4v1.6c.5-.9 1.7-1.8 3.4-1.8 3.6 0 4.3 2.4 4.3 5.5v6.2zM5.3 7.4a2.1 2.1 0 1 1 0-4.2 2.1 2.1 0 0 1 0 4.2zM7.1 20.5H3.5V9h3.6v11.5zM22.2 0H1.8C.8 0 0 .8 0 1.7v20.6c0 .9.8 1.7 1.8 1.7h20.4c1 0 1.8-.8 1.8-1.7V1.7C24 .8 23.2 0 22.2 0z"/></svg>
              </a>
            </div>
          </div>
        </div>
        <div class="reveal relative mx-auto w-full max-w-sm">
          <div class="absolute -inset-4 rounded-[2rem] bg-gradient-to-br from-accent/40 to-transparent blur-2xl"></div>
          <div class="relative overflow-hidden rounded-[2rem] border border-line bg-gradient-to-b from-accent/90 to-accent/60">
            <img src={`${base}/saeed.png`} alt={c.name} width="540" height="462" class="w-full translate-y-2 object-cover" />
          </div>
        </div>
      </div>
    </section>

    <!-- About -->
    <section id="about" class="border-t border-line py-20 sm:py-28">
      <div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-[1fr_1.4fr]">
        <h2 class="reveal text-3xl font-bold tracking-tight sm:text-4xl">{c.aboutTitle}</h2>
        <div class="reveal space-y-5 text-lg leading-relaxed text-muted">
          {c.aboutBody.map((p) => <p>{p}</p>)}
          <dl class="grid grid-cols-3 gap-4 pt-6">
            {c.stats.map((s) => (
              <div class="rounded-2xl border border-line bg-surface p-5">
                <dt class="text-xs text-muted sm:text-sm">{s.label}</dt>
                <dd class="mt-1 text-2xl font-bold text-ink sm:text-3xl">{s.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- Work -->
    <section id="work" class="border-t border-line py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="reveal flex flex-wrap items-end justify-between gap-4">
          <div>
            <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{c.workTitle}</h2>
            <p class="mt-2 text-muted">{c.workSub}</p>
          </div>
          <a href={`${links.github}?tab=repositories`} target="_blank" rel="noopener" class="text-sm font-semibold text-accent hover:underline">{c.allRepos} {arrow}</a>
        </div>
        <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {projects.map((p) => (
            <a href={p.repo} target="_blank" rel="noopener"
               class:list={["reveal group flex flex-col rounded-2xl border border-line bg-surface p-6 transition hover:-translate-y-1 hover:border-accent hover:shadow-xl hover:shadow-accent/10", p.featured && "md:col-span-2 lg:col-span-2"]}>
              <div class="flex items-start justify-between gap-4">
                <h3 class="text-xl font-semibold">{p.name}</h3>
                <span class="text-muted transition group-hover:text-accent">↗</span>
              </div>
              <p class="mt-3 flex-1 leading-relaxed text-muted">{p.desc[lang]}</p>
              <ul class="mt-5 flex flex-wrap gap-2" dir="ltr">
                {p.tags.map((tag) => <li class="rounded-full bg-accent-soft px-2.5 py-1 text-xs font-medium text-accent">{tag}</li>)}
              </ul>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Skills -->
    <section id="skills" class="border-t border-line py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 class="reveal text-3xl font-bold tracking-tight sm:text-4xl">{c.skillsTitle}</h2>
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          {skillGroups.map((g) => (
            <div class="reveal rounded-2xl border border-line bg-surface p-6">
              <h3 class="text-sm font-semibold uppercase tracking-wider text-accent">{c.skillGroups[g.key]}</h3>
              <ul class="mt-5 flex flex-wrap gap-2" dir="ltr">
                {g.items.map((s) => <li class="rounded-lg border border-line px-3 py-1.5 text-sm">{s}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Certifications -->
    <section id="certifications" class="border-t border-line py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <h2 class="reveal text-3xl font-bold tracking-tight sm:text-4xl">{c.certsTitle}</h2>
        <ul class="mt-10 divide-y divide-line overflow-hidden rounded-2xl border border-line bg-surface">
          {certifications.map((cert) => (
            <li class="reveal">
              <a href={cert.url} target="_blank" rel="noopener" class="group flex items-center justify-between gap-4 p-5 transition hover:bg-accent-soft sm:px-6">
                <div>
                  <p class="font-semibold" dir="ltr">{cert.name[lang]}</p>
                  <p class="mt-0.5 text-sm text-muted" dir="ltr">{cert.org}</p>
                </div>
                <span class="shrink-0 text-sm font-medium text-muted group-hover:text-accent">{c.verify} ↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="border-t border-line py-20 sm:py-28">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="reveal relative overflow-hidden rounded-3xl border border-line bg-surface p-8 text-center sm:p-14">
          <div class="glow pointer-events-none absolute inset-0"></div>
          <div class="relative">
            <h2 class="text-3xl font-bold tracking-tight sm:text-5xl">{c.contactTitle}</h2>
            <p class="mx-auto mt-4 max-w-xl text-lg text-muted">{c.contactBody}</p>
            <a href={links.email} class="mt-8 inline-block rounded-lg bg-accent px-6 py-3.5 font-semibold text-white shadow-lg shadow-accent/25 transition hover:-translate-y-0.5" dir="ltr">{links.emailText}</a>
            <div class="mt-6 flex justify-center gap-4 text-sm text-muted">
              <a href={links.linkedin} target="_blank" rel="noopener" class="hover:text-accent">LinkedIn</a>
              <span>·</span>
              <a href={links.github} target="_blank" rel="noopener" class="hover:text-accent">GitHub</a>
              <span>·</span>
              <a href={links.resume} target="_blank" rel="noopener" class="hover:text-accent">{c.resume}</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-line py-8">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-2 px-4 text-sm text-muted sm:px-6">
      <p>© {year} {c.name}</p>
      <p>{c.footer}</p>
    </div>
  </footer>
</Layout>
